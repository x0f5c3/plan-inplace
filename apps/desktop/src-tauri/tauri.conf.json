{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plan InPlace",
  "version": "1.2.1",
  "identifier": "com.planinplace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plan InPlace",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../assets/images/icon.png"
    ]
  }
}
